# Dependencies
node_modules/

# Environment and secrets
.env
.env.local
*.log

# Generated runtime outputs
images/*
ocr/*
outputs/*

# Keep folder placeholders
!images/.gitkeep
!ocr/.gitkeep
!outputs/.gitkeep

# Weight reconciliation backups
*.before-weight-reconciliation

# Private/source PDFs unless sanitized
pdfs/*.pdf
!pdfs/sanitized-*.pdf

# Scratch files
.scratch/

# OS/editor files
.DS_Store
Thumbs.db
.vscode/settings.json

# Python virtual environments
.venv/
agent-runtime/.venv/

# Python cache
__pycache__/
*.pyc