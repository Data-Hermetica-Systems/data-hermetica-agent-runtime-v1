# Python environments and bytecode
.venv/
venv/
__pycache__/
*.py[cod]

# Local configuration and credentials
.env
.env.*
!.env.example
*.secret
*.secret.*
.secrets/

# Live engine runtime: never commit customer data, mutable state or logs
state/
work/
logs/
quarantine/
backup/
backups/
release/
output_staging/
requests/
responses/
prepared/
claimed/

# Customer documents and generated results
*.pdf
*.png
*.jpg
*.jpeg
*.tif
*.tiff
*.csv
*.sqlite
*.sqlite3
*.db
*.db-shm
*.db-wal
*.lock

# OS/editor files
.DS_Store
Thumbs.db
.vscode/settings.json

# Permit only explicitly sanitized test fixtures when approved
!tests/fixtures/sanitized-*.pdf
!tests/fixtures/sanitized-*.csv
